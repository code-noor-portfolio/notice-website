NEXT_PUBLIC_SITE_URL=https://notice.code-noor.com

# Resend (API Routes /api/purchase et /api/contact)
RESEND_API_KEY=re_xxxxxxxx
# Dev / compte gratuit : onboarding@resend.dev
# Prod : domaine vérifié, ex. Notice <licence@notice.code-noor.com>
RESEND_FROM=Notice <onboarding@resend.dev>
SUPPORT_EMAIL=notice-code.noor@outlook.com

# HMAC secret for hashing license keys in the purchase store
PURCHASE_STORE_SECRET=change-me-in-production

# Stripe (plus tard — mode test)
NEXT_PUBLIC_STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Back-office admin (P0.4B) — public Firebase web config only ---
# NEXT_PUBLIC_* must NEVER contain Stripe/Resend/Admin secrets.
NEXT_PUBLIC_NOTICE_API_BASE=https://europe-west1-notice-1c5ae.cloudfunctions.net/api
# Local emulator example:
# NEXT_PUBLIC_NOTICE_API_BASE=http://127.0.0.1:5001/notice-1c5ae/europe-west1/api
NEXT_PUBLIC_ADMIN_SUPPORT_EMAIL=notice-code.noor@outlook.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=